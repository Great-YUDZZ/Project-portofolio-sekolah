{
  "name": "skensa-remotion-intro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:webm": "remotion render src/index.ts SkensaIntro ../public/media/intro.webm --codec=vp8",
    "render:mp4": "remotion render src/index.ts SkensaIntro ../public/media/intro.mp4 --codec=h264",
    "render:poster": "remotion still src/index.ts SkensaIntro ../public/media/intro.jpg --frame=195 --image-format=jpeg",
    "render:all": "npm run render:webm && npm run render:mp4 && npm run render:poster"
  },
  "dependencies": {
    "@remotion/cli": "4.0.270",
    "@remotion/renderer": "4.0.270",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.270"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.7.2"
  }
}

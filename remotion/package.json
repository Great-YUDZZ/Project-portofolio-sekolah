{
  "name": "skensa-remotion-intro",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:webm": "remotion render src/index.ts SkensaIntro ../public/media/intro.webm --codec=vp9 --crf=16 --gl=angle",
    "render:mp4": "remotion render src/index.ts SkensaIntro ../public/media/intro.mp4 --codec=h264 --crf=14 --x264-preset=slow --pixel-format=yuv420p --gl=angle",
    "render:poster": "remotion still src/index.ts SkensaIntro ../public/media/intro.jpg --frame=240 --image-format=jpeg --jpeg-quality=96 --gl=angle",
    "render:all": "npm run render:mp4 && npm run render:webm && npm run render:poster",
    "render:tkj:mp4": "remotion render src/index.ts TkjPromo ../public/media/tkj_promo.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --gl=angle",
    "render:tkj:webm": "remotion render src/index.ts TkjPromo ../public/media/tkj_promo.webm --codec=vp9 --crf=18 --gl=angle",
    "render:tkj:poster": "remotion still src/index.ts TkjPromo ../public/media/tkj_promo.jpg --frame=150 --image-format=jpeg --jpeg-quality=95 --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.270",
    "@remotion/renderer": "4.0.270",
    "@remotion/three": "4.0.270",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.270",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.169.0",
    "typescript": "5.7.2"
  }
}
